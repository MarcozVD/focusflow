        <Feature Id="MainProgram" Absent="disallow" AllowAdvertise="no" ConfigurableDirectory="INSTALLDIR" Description="Installs focusflow." Display="expand" Level="1" Title="Application">
            <ComponentRef Id="RegistryEntries" />
            <ComponentRef Id="I824928f03af845e3a17083310c305c2d" />
            <Feature Id="ShortcutsFeature" Level="1" Title="Shortcuts">
                <ComponentRef Id="ApplicationShortcutDesktop" />
