                        <RemoveFolder Id="INSTALLDIR" Directory="INSTALLDIR" On="uninstall" />
                        <Shortcut Id="UninstallShortcut" Directory="INSTALLDIR" Name="Uninstall focusflow" ShortName="zyeei5qq" Description="Uninstalls focusflow" Arguments="/x [ProductCode]" Advertise="yes" />
