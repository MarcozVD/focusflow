                        <Shortcut Id="ApplicationStartMenuShortcut" Directory="ApplicationProgramsFolder" Name="focusflow" ShortName="iqloearz" Target="[!Path]" Description="Runs focusflow" Icon="ProductIcon" WorkingDirectory="INSTALLDIR">
                            <ShortcutProperty Id="scpA928DBE89B302EBC9C3D7CA666BC5A03" Key="System.AppUserModel.ID" Value="com.focusflow.spike" />
